# Kopieren nach .env und Werte ausfüllen:  cp .env.example .env

# Domain, unter der NAYA TIME erreichbar ist (Caddy holt automatisch ein HTTPS-Zertifikat)
DOMAIN=zeit.naya-restaurant.de

# E-Mail für Hinweise von Let's Encrypt (z. B. wenn ein Zertifikat abläuft)
ACME_EMAIL=zeit@naya-restaurant.de

# Passwort für den Admin-Bereich (/admin) – lang und eindeutig wählen
ADMIN_PASSWORT=

# Zufällige Geheimnisse. Erzeugen z. B. mit:  openssl rand -hex 32
SESSION_SECRET=
TERMINAL_SCHLUESSEL=

# Pausenregel: PAUSE_MINUTEN werden abgezogen, wenn an einem Tag mehr als PAUSE_AB_STUNDEN gearbeitet wurde.
# PAUSE_AB_STUNDEN=0 bedeutet: an jedem Arbeitstag abziehen.
PAUSE_MINUTEN=30
PAUSE_AB_STUNDEN=6

# Ist ein Einstempeln älter als so viele Stunden, gilt das Ausstempeln als vergessen
MAX_SCHICHT_STUNDEN=16

# Stempelfotos werden nach so vielen Tagen automatisch gelöscht (0 = nie)
FOTO_AUFBEWAHRUNG_TAGE=90
