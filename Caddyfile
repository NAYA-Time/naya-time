{
	# Die DNS-Zone von naya-restaurant.de erlaubt per CAA-Eintrag nur Let's Encrypt.
	# Deshalb fest auf Let's Encrypt stellen (kein Ausweichen auf ZeroSSL o. Ä.).
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:3000
}
